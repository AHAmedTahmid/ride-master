# =============================================================================
# RIDE MASTER — Environment Variables
# Copy to .env and fill real values. Never commit .env.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3000

# ── Database (MySQL 8.4) ──────────────────────────────────────────────────────
DATABASE_URL=mysql://ridemaster:secret@localhost:3306/ride_master
DATABASE_URL_TEST=mysql://ridemaster:secret@localhost:3306/ride_master_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (generate: openssl rand -hex 64) ─────────────────────────────────────
JWT_SECRET=change_me_64_byte_hex
JWT_REFRESH_SECRET=change_me_another_64_byte_hex
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=10

# ── Providers ─────────────────────────────────────────────────────────────────
SMS_PROVIDER=console
MAP_PROVIDER=haversine
STORAGE_PROVIDER=minio

# ── MinIO (local S3) ──────────────────────────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ride-master
STORAGE_REGION=us-east-1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# ── Business defaults (overridden by platform_settings table) ────────────────
DEFAULT_COMMISSION_BPS=1000
REQUEST_TIMEOUT_SECONDS=60
INDIVIDUAL_VEHICLE_LIMIT=3
NEW_COMPANY_STARTING_CREDIT_LAARI=50000
DAILY_SMS_BUDGET=1000

# ── Next.js public vars ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
