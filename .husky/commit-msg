#!/usr/bin/env sh
# Conventional commit subject check: type(scope?): description
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
echo "$first_line" | grep -Eq '^(feat|fix|chore|docs|test|refactor|perf|build|ci|style|revert)(\([a-z0-9-]+\))?: .+' || {
  echo "Commit subject must match: type(scope): message" >&2
  echo "Got: $first_line" >&2
  exit 1
}
